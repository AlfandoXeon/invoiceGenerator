<header id="app-navbar" class="bg-white border-b border-slate-200 text-slate-800 sticky top-0 z-40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex justify-between items-center">
    
    <!-- Info Toko Sederhana -->
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-lg bg-red-600 text-white flex items-center justify-center font-bold">
        <span class="material-symbols-outlined text-xl">store</span>
      </div>
      <div>
        <h1 class="text-base sm:text-lg font-bold text-slate-900 leading-tight">
          <%= (typeof config !== 'undefined' && config.store && config.store.name) ? config.store.name : 'Toko Anda' %>
        </h1>
        <p class="text-xs text-slate-500">
          <%= (typeof config !== 'undefined' && config.store && config.store.tagline) ? config.store.tagline : 'Aplikasi Kasir & Struk Belanja' %>
        </p>
      </div>
    </div>

    <!-- Tanggal & Jam Sederhana -->
    <div class="flex items-center gap-2 text-xs text-slate-500">
      <span class="material-symbols-outlined text-sm text-slate-400">schedule</span>
      <span id="nav-live-clock" class="font-medium text-slate-600">--:--:--</span>
    </div>

  </div>
</header>

<script>
  function updateNavClock() {
    const el = document.getElementById('nav-live-clock');
    if (!el) return;
    const now = new Date();
    el.innerText = now.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) + ' ' + now.toLocaleTimeString('id-ID', { hour12: false });
  }
  setInterval(updateNavClock, 1000);
  updateNavClock();
</script>
