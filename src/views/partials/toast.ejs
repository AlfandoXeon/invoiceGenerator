<!-- Toast Container -->
<div id="toast-container" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 pointer-events-none max-w-sm"></div>

<script>
  function showToast(message, type = 'info', duration = 2800) {
    const container = document.getElementById('toast-container');
    if (!container) return;

    const toast = document.createElement('div');
    toast.className = `pointer-events-auto flex items-center gap-2.5 px-4 py-3 rounded-xl shadow-lg text-xs font-semibold transition-all duration-200 transform translate-y-3 opacity-0 border`;
    toast.style.backgroundColor = 'var(--color-bg-card)';
    toast.style.color = 'var(--color-text-main)';
    toast.style.borderColor = 'var(--color-border)';

    let iconName = 'info';
    let iconColor = 'var(--color-text-muted)';
    
    if (type === 'success') {
      iconName = 'check_circle';
      iconColor = 'var(--color-success)';
      toast.style.borderColor = 'rgba(5, 150, 105, 0.3)';
    } else if (type === 'warning') {
      iconName = 'warning';
      iconColor = 'var(--color-warning)';
      toast.style.borderColor = 'rgba(217, 119, 6, 0.3)';
    } else if (type === 'error') {
      iconName = 'error';
      iconColor = 'var(--color-destructive)';
      toast.style.borderColor = 'rgba(220, 38, 38, 0.3)';
    }

    toast.innerHTML = `
      <span class="material-symbols-outlined text-lg shrink-0" style="color: ${iconColor}" aria-hidden="true">${iconName}</span>
      <span class="leading-tight">${message}</span>
    `;

    container.appendChild(toast);

    requestAnimationFrame(() => {
      toast.classList.remove('translate-y-3', 'opacity-0');
      toast.classList.add('translate-y-0', 'opacity-100');
    });

    setTimeout(() => {
      toast.classList.remove('translate-y-0', 'opacity-100');
      toast.classList.add('translate-y-3', 'opacity-0');
      setTimeout(() => {
        if (toast.parentNode) {
          toast.parentNode.removeChild(toast);
        }
      }, 200);
    }, duration);
  }

  window.showToast = showToast;
</script>
