<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen flex flex-col bg-slate-50 text-slate-800">

  <!-- Header -->
  <%- include('../partials/navbar') %>

  <!-- Navigasi -->
  <%- include('../partials/navigation') %>

  <!-- Konten Utama -->
  <main class="flex-grow max-w-7xl w-full mx-auto px-4 py-6 sm:px-6 lg:px-8 flex flex-col gap-6">

    <!-- Ringkasan Singkat Hari Ini -->
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 no-print" data-aos="fade-down">
      <div class="clean-card p-4">
        <span class="text-xs font-semibold text-slate-500">Penjualan Hari Ini</span>
        <p class="text-lg sm:text-xl font-bold text-slate-900 mt-1"><%= formatRupiah(stats.todaySales) %></p>
      </div>

      <div class="clean-card p-4">
        <span class="text-xs font-semibold text-slate-500">Transaksi Hari Ini</span>
        <p class="text-lg sm:text-xl font-bold text-slate-900 mt-1"><%= stats.todayCount %> Nota</p>
      </div>

      <div class="clean-card p-4 col-span-2 sm:col-span-1">
        <span class="text-xs font-semibold text-slate-500">Jumlah Barang Terdaftar</span>
        <p class="text-lg sm:text-xl font-bold text-slate-900 mt-1"><%= products.length %> Produk</p>
      </div>
    </div>

    <!-- AREA KASIR UTAMA: 2 KOLOM -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      
      <!-- KOLOM KIRI: FORM & TABEL (7 KOLOM) -->
      <section class="lg:col-span-7 flex flex-col gap-5 no-print" data-aos="fade-up">
        
        <!-- BAGIAN 1: INPUT BARANG -->
        <div class="clean-card p-5">
          <div class="flex items-center justify-between mb-3">
            <h2 class="text-sm font-bold text-slate-900 flex items-center gap-2">
              <span class="material-symbols-outlined text-red-600 text-lg">add_shopping_cart</span>
              <span>Tambah Barang</span>
            </h2>
            <span class="text-xs text-slate-400">Pilih dari daftar atau ketik baru</span>
          </div>

          <form id="add-item-form" onsubmit="handleFormAddItem(event)" class="grid grid-cols-12 gap-3">
            <div class="col-span-12 sm:col-span-6">
              <label class="clean-label">Nama Barang</label>
              <input type="text" id="quick-item-name" placeholder="Pilih atau ketik barang..." list="products-datalist" autocomplete="off" required class="clean-input">
              <datalist id="products-datalist">
                <% products.forEach(function(p) { %>
                  <option value="<%= p.name %>" data-price="<%= p.sellingPrice %>">
                    <%= formatRupiah(p.sellingPrice) %> - Stok: <%= p.stock %>
                  </option>
                <% }); %>
              </datalist>
            </div>

            <div class="col-span-6 sm:col-span-3">
              <label class="clean-label">Harga Satuan (Rp)</label>
              <input type="number" id="quick-item-price" min="0" placeholder="0" required class="clean-input font-medium">
            </div>

            <div class="col-span-6 sm:col-span-3">
              <label class="clean-label">Jumlah</label>
              <div class="flex gap-2">
                <input type="number" id="quick-item-qty" min="1" value="1" required class="clean-input text-center font-bold">
                <button type="submit" class="clean-btn-primary px-3" title="Tambah">
                  <span class="material-symbols-outlined text-lg">add</span>
                </button>
              </div>
            </div>
          </form>

          <!-- Pilihan Cepat Barang Populer -->
          <% if (products.length > 0) { %>
            <div class="mt-3 pt-3 border-t border-slate-100">
              <span class="text-[11px] font-semibold text-slate-500 block mb-1.5">Pilihan Cepat:</span>
              <div class="flex flex-wrap gap-1.5 max-h-20 overflow-y-auto">
                <% products.slice(0, 8).forEach(function(prod) { %>
                  <button type="button" onclick="CashierApp.addFromPreset('<%= prod.id %>')" class="px-2.5 py-1 rounded-md text-xs bg-slate-100 hover:bg-slate-200 text-slate-700 transition flex items-center gap-1 active:scale-95">
                    <span><%= prod.name %></span>
                    <span class="text-slate-400 text-[11px]">(<%= formatRupiah(prod.sellingPrice).replace('Rp', '') %>)</span>
                  </button>
                <% }); %>
              </div>
            </div>
          <% } %>
        </div>

        <!-- BAGIAN 2: TABEL KERANJANG -->
        <div class="clean-card overflow-hidden">
          <div class="p-3.5 border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
            <h3 class="font-bold text-xs sm:text-sm text-slate-800 flex items-center gap-2">
              <span class="material-symbols-outlined text-slate-500 text-base">shopping_cart</span>
              <span>Daftar Belanjaan</span>
            </h3>
            <button type="button" onclick="CashierApp.clearAll()" class="text-xs text-slate-500 hover:text-red-600 transition flex items-center gap-1">
              <span class="material-symbols-outlined text-sm">clear_all</span>
              <span>Kosongkan</span>
            </button>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead class="bg-slate-50 text-slate-500 uppercase text-[10px] font-bold tracking-wider border-b border-slate-100">
                <tr>
                  <th class="py-2.5 px-3">Barang</th>
                  <th class="py-2.5 px-2 text-center w-28">Jumlah</th>
                  <th class="py-2.5 px-3 text-right">Harga</th>
                  <th class="py-2.5 px-3 text-right">Total</th>
                  <th class="py-2.5 px-2 text-center w-12">Aksi</th>
                </tr>
              </thead>
              <tbody id="cashier-items-body" class="divide-y divide-slate-100">
                <!-- Render dinamis oleh cashier.js -->
              </tbody>
            </table>
          </div>
        </div>

        <!-- BAGIAN 3: PEMBAYARAN & KALKULATOR -->
        <div class="clean-card p-5">
          <h3 class="font-bold text-sm text-slate-800 flex items-center gap-2 mb-3">
            <span class="material-symbols-outlined text-slate-600 text-lg">payments</span>
            <span>Rincian Pembayaran</span>
          </h3>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            
            <!-- Kolom Pengaturan Nota -->
            <div class="space-y-3 bg-slate-50 p-3.5 rounded-lg border border-slate-200">
              <div>
                <label class="clean-label">Nomor Nota</label>
                <input type="text" id="input-invoice-number" oninput="CashierApp.updateStateFromInputs()" value="<%= nextInvoice %>" class="clean-input font-mono font-bold text-slate-800">
              </div>
              <div class="grid grid-cols-2 gap-2">
                <div>
                  <label class="clean-label">Nama Kasir</label>
                  <% if (config.pos && config.pos.cashiers && config.pos.cashiers.length > 0) { %>
                    <select id="input-cashier" onchange="CashierApp.updateStateFromInputs()" class="clean-input">
                      <% config.pos.cashiers.forEach(function(c) { %>
                        <option value="<%= c %>" <%= (config.pos.defaultCashier === c) ? 'selected' : '' %>><%= c %></option>
                      <% }); %>
                    </select>
                  <% } else { %>
                    <input type="text" id="input-cashier" oninput="CashierApp.updateStateFromInputs()" value="<%= config.pos.defaultCashier %>" class="clean-input">
                  <% } %>
                </div>
                <div>
                  <label class="clean-label">Metode Bayar</label>
                  <select id="select-payment-method" onchange="CashierApp.updateStateFromInputs()" class="clean-input">
                    <option value="TUNAI">TUNAI</option>
                    <option value="QRIS">QRIS</option>
                    <option value="DEBIT">KARTU DEBIT</option>
                    <option value="TRANSFER">TRANSFER BANK</option>
                  </select>
                </div>
              </div>
              <div class="grid grid-cols-2 gap-2">
                <div>
                  <label class="clean-label">Potongan Diskon (Rp)</label>
                  <input type="number" id="input-discount" min="0" value="0" oninput="CashierApp.updateStateFromInputs()" class="clean-input font-medium">
                </div>
                <div>
                  <label class="clean-label">Pajak PPN (%)</label>
                  <input type="number" id="input-tax-percent" min="0" value="<%= config.pos.defaultTaxPercent %>" oninput="CashierApp.updateStateFromInputs()" class="clean-input font-medium">
                </div>
              </div>
            </div>

            <!-- Kolom Uang Tunai & Total -->
            <div class="space-y-3 bg-slate-50 p-3.5 rounded-lg border border-slate-200 flex flex-col justify-between">
              <div>
                <label class="clean-label text-slate-700">Uang Diterima (Rp)</label>
                <input type="number" id="input-cash" min="0" value="0" oninput="CashierApp.updateStateFromInputs()" class="clean-input font-bold text-base text-slate-900">
              </div>

              <!-- Tombol Cepat Nominal -->
              <div>
                <span class="text-[10px] font-semibold text-slate-500 block mb-1">Pilihan Cepat:</span>
                <div class="flex flex-wrap gap-1.5">
                  <button type="button" onclick="CashierApp.setFastCash('exact')" class="px-2 py-1 rounded bg-slate-800 hover:bg-slate-900 text-white font-semibold text-xs">Uang Pas</button>
                  <button type="button" onclick="CashierApp.setFastCash(10000)" class="px-2 py-1 rounded bg-white hover:bg-slate-100 text-slate-700 text-xs border border-slate-300">10k</button>
                  <button type="button" onclick="CashierApp.setFastCash(20000)" class="px-2 py-1 rounded bg-white hover:bg-slate-100 text-slate-700 text-xs border border-slate-300">20k</button>
                  <button type="button" onclick="CashierApp.setFastCash(50000)" class="px-2 py-1 rounded bg-white hover:bg-slate-100 text-slate-700 text-xs border border-slate-300">50k</button>
                  <button type="button" onclick="CashierApp.setFastCash(100000)" class="px-2 py-1 rounded bg-white hover:bg-slate-100 text-slate-700 text-xs border border-slate-300">100k</button>
                </div>
              </div>

              <!-- Tampilan Total & Kembalian -->
              <div class="pt-2 border-t border-slate-200 flex justify-between items-end">
                <div>
                  <span class="text-xs text-slate-500">Kembalian:</span>
                  <div id="val-change" class="text-lg font-bold text-emerald-600">Rp0</div>
                </div>
                <div class="text-right">
                  <span class="text-xs text-slate-500">Total Belanja:</span>
                  <div id="val-grandtotal" class="text-xl font-extrabold text-red-600">Rp0</div>
                </div>
              </div>

            </div>

          </div>

          <!-- TOMBOL AKSI UTAMA DENGAN VALIDASI SEBELUM CETAK -->
          <div class="mt-4 pt-3 border-t border-slate-100 flex flex-col sm:flex-row gap-3">
            <button type="button" onclick="CashierApp.startCheckout('print')" class="clean-btn-primary flex-1 py-2.5 text-sm">
              <span class="material-symbols-outlined text-lg">print</span>
              <span>Cetak Struk</span>
            </button>
            <button type="button" id="btn-download-png" onclick="CashierApp.startCheckout('png')" class="clean-btn-secondary flex-1 py-2.5 text-sm">
              <span class="material-symbols-outlined text-lg text-slate-600">image</span>
              <span>Simpan Gambar (WhatsApp)</span>
            </button>
          </div>

        </div>

      </section>

      <!-- KOLOM KANAN: TAMPILAN STRUK (5 KOLOM) -->
      <section class="lg:col-span-5 flex flex-col items-center gap-3 sticky top-28" data-aos="fade-left">
        
        <div class="w-full max-w-[360px] flex justify-between items-center text-xs text-slate-500 px-1 no-print">
          <span class="font-semibold flex items-center gap-1.5">
            <span class="material-symbols-outlined text-base text-slate-500">receipt</span>
            <span>Tampilan Struk (<%= config.pos.paperSize %>)</span>
          </span>
        </div>

        <!-- WADAH KERTAS STRUK -->
        <div class="w-full max-w-[360px] receipt-paper-container paper-<%= config.pos.paperSize %> bg-white" id="receipt-paper">
          
          <div class="p-5 text-slate-900 thermal-receipt" style="font-family: 'Courier Prime', monospace;">
            
            <!-- Logo Toko Jika Ada -->
            <% if (config.store.useLogoOnReceipt && config.store.logoUrl) { %>
              <div class="flex justify-center mb-2">
                <img src="<%= config.store.logoUrl %>" alt="Logo" class="max-h-12 max-w-[120px] object-contain grayscale">
              </div>
            <% } %>

            <!-- Identitas Toko -->
            <div class="text-center mb-2">
              <h2 class="text-sm sm:text-base font-bold uppercase tracking-tight text-black" id="preview-store-name">
                <%= config.store.name %>
              </h2>
              <% if (config.store.tagline) { %>
                <p class="text-[10px] text-slate-600 mt-0.5">
                  <%= config.store.tagline %>
                </p>
              <% } %>
              <% if (config.store.address) { %>
                <p class="text-[9px] text-slate-500 mt-0.5 leading-tight">
                  <%= config.store.address %>
                </p>
              <% } %>
              <% if (config.store.phone) { %>
                <p class="text-[9px] text-slate-500">
                  Telp: <%= config.store.phone %>
                </p>
              <% } %>
            </div>

            <div class="thermal-dashed-line"></div>

            <!-- Metadata Nota -->
            <div class="text-[10px] text-slate-700 grid grid-cols-2 gap-y-0.5 font-mono mb-1">
              <div>No: <span id="preview-receipt-no" class="font-bold"><%= nextInvoice %></span></div>
              <div class="text-right"><span id="preview-date"><%= new Date().toLocaleDateString('id-ID') %></span></div>
              <div>Kasir: <span id="preview-cashier"><%= config.pos.defaultCashier %></span></div>
              <div class="text-right">Bayar: <span id="preview-payment-method" class="font-bold">TUNAI</span></div>
            </div>

            <div class="thermal-dashed-line"></div>

            <!-- Header Daftar Barang -->
            <div class="text-[10px] font-bold text-black flex justify-between py-0.5">
              <span>BARANG</span>
              <span>TOTAL</span>
            </div>
            <div class="receipt-divider-dotted"></div>

            <!-- Daftar Item Dinamis -->
            <div id="preview-items-list" class="min-h-[40px] flex flex-col gap-1">
              <!-- Render via JS -->
            </div>

            <div class="thermal-dashed-line"></div>

            <!-- Rincian Total -->
            <div class="text-[10px] space-y-0.5 font-mono">
              <div class="flex justify-between">
                <span>SUBTOTAL</span>
                <span id="prev-subtotal" class="font-bold">Rp0</span>
              </div>
              <div class="flex justify-between text-slate-600">
                <span>DISKON</span>
                <span id="prev-discount">Rp0</span>
              </div>
              <div class="flex justify-between text-slate-600">
                <span>PPN (<span id="prev-tax-rate"><%= config.pos.defaultTaxPercent %></span>%)</span>
                <span id="prev-tax-amount">Rp0</span>
              </div>
              <div class="receipt-divider-dotted"></div>
              <div class="flex justify-between font-bold text-xs text-black pt-0.5">
                <span>TOTAL AKHIR</span>
                <span id="prev-grandtotal" class="text-black">Rp0</span>
              </div>
              <div class="flex justify-between text-slate-700 pt-0.5">
                <span>BAYAR</span>
                <span id="prev-cash">Rp0</span>
              </div>
              <div class="flex justify-between font-bold text-black">
                <span>KEMBALIAN</span>
                <span id="prev-change" class="text-black">Rp0</span>
              </div>
            </div>

            <div class="thermal-dashed-line"></div>

            <!-- Pesan Footer Struk -->
            <div class="text-center mt-2 flex flex-col items-center gap-1.5">
              <p class="text-[9px] text-slate-600 leading-relaxed whitespace-pre-line" id="preview-footer-note">
                <%= config.pos.footerNote %>
              </p>
            </div>

          </div>

        </div>

      </section>

    </div>

  </main>

  <!-- MODAL KONFIRMASI / VALIDASI SEBELUM CETAK & SIMPAN -->
  <div id="order-confirm-modal" class="fixed inset-0 z-50 bg-black/40 hidden items-center justify-center p-4">
    <div class="clean-card w-full max-w-md p-6 bg-white shadow-2xl relative" data-aos="zoom-in" data-aos-duration="250">
      
      <div class="flex justify-between items-center mb-3 pb-2 border-b border-slate-100">
        <h3 class="font-bold text-sm sm:text-base text-slate-900 flex items-center gap-2">
          <span class="material-symbols-outlined text-slate-700">fact_check</span>
          <span>Periksa Kembali Pesanan</span>
        </h3>
        <button type="button" onclick="CashierApp.closeConfirmModal()" class="text-slate-400 hover:text-slate-600">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>

      <p class="text-xs text-slate-500 mb-3">
        Pastikan daftar pesanan dan uang pembayaran pelanggan sudah sesuai sebelum dicetak:
      </p>

      <!-- Ringkasan Info Nota -->
      <div class="bg-slate-50 p-3 rounded-lg border border-slate-200 text-xs space-y-1 mb-3">
        <div class="flex justify-between">
          <span class="text-slate-500">Nomor Nota:</span>
          <span id="conf-invoice" class="font-bold font-mono text-slate-800">-</span>
        </div>
        <div class="flex justify-between">
          <span class="text-slate-500">Kasir:</span>
          <span id="conf-cashier" class="font-medium text-slate-800">-</span>
        </div>
        <div class="flex justify-between">
          <span class="text-slate-500">Pembayaran:</span>
          <span id="conf-method" class="font-medium text-slate-800">-</span>
        </div>
        <div class="flex justify-between">
          <span class="text-slate-500">Total Item:</span>
          <span id="conf-total-items" class="font-medium text-slate-800">-</span>
        </div>
      </div>

      <!-- Ringkasan Item Pesanan -->
      <div class="border border-slate-200 rounded-lg p-2.5 max-h-36 overflow-y-auto mb-3" id="conf-items-summary">
        <!-- Terisi dinamis oleh JS -->
      </div>

      <!-- Ringkasan Finansial -->
      <div class="space-y-1 bg-slate-50 p-3 rounded-lg border border-slate-200 text-xs font-mono">
        <div class="flex justify-between font-bold text-sm text-slate-900">
          <span>Total Belanja:</span>
          <span id="conf-grandtotal" class="text-red-600">Rp0</span>
        </div>
        <div class="flex justify-between text-slate-600">
          <span>Uang Diterima:</span>
          <span id="conf-cash">Rp0</span>
        </div>
        <div class="flex justify-between font-bold text-emerald-600">
          <span>Kembalian:</span>
          <span id="conf-change">Rp0</span>
        </div>
      </div>

      <!-- Peringatan Kurang Bayar (Jika ada) -->
      <div id="conf-warning-box" class="hidden mt-2 p-2 rounded bg-amber-50 border border-amber-200 text-amber-800 text-[11px] font-medium"></div>

      <!-- Tombol Aksi Konfirmasi -->
      <div class="mt-4 pt-3 border-t border-slate-100 flex flex-col gap-2">
        <div class="flex gap-2">
          <button type="button" onclick="CashierApp.closeConfirmModal()" class="clean-btn-secondary text-xs flex-1">
            <span>Periksa Lagi (Batal)</span>
          </button>
          <button type="button" onclick="CashierApp.confirmAndExecute(true)" class="clean-btn-primary text-xs flex-1">
            <span class="material-symbols-outlined text-sm">check</span>
            <span>Ya, Cetak & Simpan</span>
          </button>
        </div>
        <div class="text-center pt-1">
          <button type="button" onclick="CashierApp.confirmAndExecute(false)" class="text-[11px] text-slate-400 hover:text-slate-700 underline">
            Hanya Cetak (Tanpa Simpan ke Riwayat)
          </button>
        </div>
      </div>

    </div>
  </div>

  <!-- Footer -->
  <%- include('../partials/footer') %>

  <!-- Toast Notifikasi -->
  <%- include('../partials/toast') %>

  <!-- Script Konfigurasi & Produk -->
  <script>
    window.APP_CONFIG = <%- JSON.stringify(config) %>;
    window.STORE_PRODUCTS = <%- JSON.stringify(products) %>;
  </script>

  <script src="/js/receipt-exporter.js"></script>
  <script src="/js/cashier.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      CashierApp.init(window.APP_CONFIG, '<%= nextInvoice %>');

      const nameInput = document.getElementById('quick-item-name');
      const priceInput = document.getElementById('quick-item-price');
      nameInput.addEventListener('input', (e) => {
        const val = e.target.value.toLowerCase().trim();
        const matched = window.STORE_PRODUCTS.find(p => p.name.toLowerCase() === val || (p.barcode && p.barcode.toLowerCase() === val));
        if (matched) {
          priceInput.value = matched.sellingPrice;
        }
      });
    });

    function handleFormAddItem(e) {
      e.preventDefault();
      const name = document.getElementById('quick-item-name').value;
      const price = document.getElementById('quick-item-price').value;
      const qty = document.getElementById('quick-item-qty').value;
      
      CashierApp.addItem(name, price, qty);

      document.getElementById('quick-item-name').value = '';
      document.getElementById('quick-item-price').value = '';
      document.getElementById('quick-item-qty').value = '1';
      document.getElementById('quick-item-name').focus();
    }
  </script>
</body>
</html>
