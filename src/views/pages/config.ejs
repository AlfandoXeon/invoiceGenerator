<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen flex flex-col">

  <!-- Header -->
  <%- include('../partials/navbar') %>

  <!-- Navigasi -->
  <%- include('../partials/navigation') %>

  <!-- Konten Utama -->
  <main class="flex-grow max-w-5xl w-full mx-auto px-4 py-5 sm:px-6 lg:px-8 flex flex-col gap-5">

    <!-- Judul Halaman -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3" data-aos="fade-down">
      <div>
        <h2 class="text-base sm:text-lg font-bold flex items-center gap-2 text-[var(--color-text-main)]">
          <span class="material-symbols-outlined text-lg text-[var(--color-primary)]" aria-hidden="true">storefront</span>
          <span>Profil Toko & Pengaturan Struk</span>
        </h2>
        <p class="text-xs text-[var(--color-text-muted)] mt-0.5">
          Atur identitas merek toko, nomor kontak, logo, dan format tampilan kertas struk.
        </p>
      </div>

      <% if (typeof successMessage !== 'undefined' && successMessage) { %>
        <div class="px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 border" style="background-color: var(--color-success-subtle); color: var(--color-success); border-color: rgba(5, 150, 105, 0.3)">
          <span class="material-symbols-outlined text-base" aria-hidden="true">check_circle</span>
          <span><%= successMessage %></span>
        </div>
      <% } %>
    </div>

    <!-- FORM PENGATURAN TOKO -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">

      <!-- KOLOM 1: LOGO TOKO -->
      <div class="pos-card p-5 flex flex-col items-center gap-3.5 text-center h-fit" data-aos="fade-right">
        <h3 class="font-bold text-xs sm:text-sm text-[var(--color-text-main)]">
          Logo Struk Toko
        </h3>

        <!-- Kotak Pratinjau Logo -->
        <div class="w-32 h-32 rounded-2xl bg-[var(--color-bg-subtle)] border-2 border-dashed border-[var(--color-border-strong)] flex items-center justify-center p-2.5 relative overflow-hidden">
          <% if (config.store.logoUrl) { %>
            <img src="<%= config.store.logoUrl %>" alt="Logo Toko" class="max-w-full max-h-full object-contain">
          <% } else { %>
            <div class="flex flex-col items-center text-[var(--color-text-subtle)] gap-1">
              <span class="material-symbols-outlined text-4xl opacity-50" aria-hidden="true">image</span>
              <span class="text-[10px]">Belum ada logo</span>
            </div>
          <% } %>
        </div>

        <!-- Form Upload Logo -->
        <form action="/config/logo" method="POST" enctype="multipart/form-data" class="w-full flex flex-col gap-2">
          <label class="pos-btn pos-btn-secondary text-xs py-2 w-full cursor-pointer">
            <span class="material-symbols-outlined text-base" aria-hidden="true">upload</span>
            <span>Unggah / Ganti Logo</span>
            <input type="file" name="logo" accept="image/*" class="hidden" onchange="this.form.submit()">
          </label>
          <span class="text-[10px] text-[var(--color-text-subtle)]">Format: PNG, JPG, WEBP (Maks 3MB)</span>
        </form>
      </div>

      <!-- KOLOM 2 & 3: FORM ISIAN IDENTITAS & STRUK -->
      <div class="md:col-span-2 pos-card p-5 sm:p-6" data-aos="fade-left">
        <form action="/config" method="POST" class="flex flex-col gap-5">

          <!-- Bagian 1: Data Identitas Toko -->
          <div>
            <h4 class="text-xs font-bold uppercase tracking-wider mb-3 text-[var(--color-text-muted)] flex items-center gap-1.5">
              <span class="material-symbols-outlined text-sm" aria-hidden="true">badge</span>
              <span>Identitas Usaha</span>
            </h4>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
              <div class="sm:col-span-2">
                <label class="pos-label">Nama Toko *</label>
                <input type="text" name="storeName" value="<%= config.store.name %>" required class="pos-input font-bold">
              </div>
              <div class="sm:col-span-2">
                <label class="pos-label">Slogan / Tagline Toko</label>
                <input type="text" name="tagline" value="<%= config.store.tagline %>" placeholder="Contoh: Belanja Puas, Harga Pas!" class="pos-input">
              </div>
              <div class="sm:col-span-2">
                <label class="pos-label">Alamat Lengkap Toko</label>
                <input type="text" name="address" value="<%= config.store.address %>" placeholder="Alamat jalan, kota..." class="pos-input">
              </div>
              <div>
                <label class="pos-label">Nomor WhatsApp / Telepon</label>
                <input type="text" name="phone" value="<%= config.store.phone %>" placeholder="08xxxxxxxx" class="pos-input font-mono">
              </div>
              <div>
                <label class="pos-label">Email Toko (Opsional)</label>
                <input type="email" name="email" value="<%= config.store.email %>" placeholder="toko@gmail.com" class="pos-input">
              </div>
              <div class="sm:col-span-2 flex items-center gap-2 pt-1">
                <input type="checkbox" id="useLogoOnReceipt" name="useLogoOnReceipt" <%= config.store.useLogoOnReceipt ? 'checked' : '' %> class="w-4 h-4 rounded text-blue-600 border-[var(--color-border)]">
                <label for="useLogoOnReceipt" class="text-xs font-medium cursor-pointer text-[var(--color-text-main)]">
                  Cetak logo toko di bagian atas kertas struk belanja
                </label>
              </div>
            </div>
          </div>

          <div class="border-t border-[var(--color-border-subtle)]"></div>

          <!-- Bagian 2: Pengaturan Struk & Thermal -->
          <div>
            <h4 class="text-xs font-bold uppercase tracking-wider mb-3 text-[var(--color-text-muted)] flex items-center gap-1.5">
              <span class="material-symbols-outlined text-sm" aria-hidden="true">receipt</span>
              <span>Format Struk Thermal</span>
            </h4>
            
            <!-- Pilihan Ukuran Kertas -->
            <div class="mb-4">
              <label class="pos-label">Ukuran Kertas Printer Default</label>
              <div class="grid grid-cols-2 gap-3 mt-1">
                <label class="flex items-center gap-2.5 p-3 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-subtle)] cursor-pointer hover:border-[var(--color-border-strong)] transition">
                  <input type="radio" name="paperSize" value="58mm" <%= config.pos.paperSize === '58mm' ? 'checked' : '' %> class="text-blue-600">
                  <div>
                    <div class="text-xs font-bold text-[var(--color-text-main)]">58mm (Kertas Mini)</div>
                    <div class="text-[10px] text-[var(--color-text-muted)]">Printer Bluetooth / POS portable</div>
                  </div>
                </label>
                <label class="flex items-center gap-2.5 p-3 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-subtle)] cursor-pointer hover:border-[var(--color-border-strong)] transition">
                  <input type="radio" name="paperSize" value="80mm" <%= config.pos.paperSize === '80mm' ? 'checked' : '' %> class="text-blue-600">
                  <div>
                    <div class="text-xs font-bold text-[var(--color-text-main)]">80mm (Kertas Lebar)</div>
                    <div class="text-[10px] text-[var(--color-text-muted)]">Printer desktop thermal standar kasir</div>
                  </div>
                </label>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5">
              <div>
                <label class="pos-label">Nama Kasir Utama</label>
                <input type="text" name="defaultCashier" value="<%= config.pos.defaultCashier %>" class="pos-input">
              </div>
              <div>
                <label class="pos-label">Awalan Nomor Nota</label>
                <input type="text" name="invoicePrefix" value="<%= config.pos.invoicePrefix %>" class="pos-input font-mono font-medium">
              </div>
              <div>
                <label class="pos-label">Tarif Pajak PPN (%)</label>
                <input type="number" name="defaultTaxPercent" value="<%= config.pos.defaultTaxPercent %>" min="0" class="pos-input font-mono">
              </div>
            </div>

            <div class="mt-3.5">
              <label class="pos-label">Pesan Catatan Kaki Struk (Footer Note)</label>
              <textarea name="footerNote" rows="3" class="pos-textarea text-xs resize-none font-mono"><%= config.pos.footerNote %></textarea>
            </div>
          </div>

          <!-- Tombol Simpan -->
          <div class="pt-2 flex justify-end">
            <button type="submit" class="pos-btn pos-btn-primary px-6 py-2.5 text-xs sm:text-sm">
              <span class="material-symbols-outlined text-base" aria-hidden="true">save</span>
              <span>Simpan Profil Toko</span>
            </button>
          </div>

        </form>
      </div>

    </div>

  </main>

  <!-- Footer -->
  <%- include('../partials/footer') %>

  <!-- Toast -->
  <%- include('../partials/toast') %>

</body>
</html>
