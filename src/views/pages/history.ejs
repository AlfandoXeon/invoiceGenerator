<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen flex flex-col">

  <!-- Header -->
  <%- include('../partials/navbar') %>

  <!-- Navigasi -->
  <%- include('../partials/navigation') %>

  <!-- Konten Utama -->
  <main class="flex-grow max-w-7xl w-full mx-auto px-4 py-5 sm:px-6 lg:px-8 flex flex-col gap-5">

    <!-- Header Judul & Ringkasan Metrik Omset -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4" data-aos="fade-down">
      <div>
        <h2 class="text-base sm:text-lg font-bold flex items-center gap-2 text-[var(--color-text-main)]">
          <span class="material-symbols-outlined text-lg text-[var(--color-primary)]" aria-hidden="true">receipt_long</span>
          <span>Riwayat Transaksi Penjualan</span>
        </h2>
        <p class="text-xs text-[var(--color-text-muted)] mt-0.5">
          Rekap seluruh nota kasir yang pernah dicetak dan tercatat di database lokal.
        </p>
      </div>

      <!-- Kartu Ringkasan Metrik -->
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 w-full md:w-auto">
        <div class="pos-card px-3.5 py-2">
          <span class="text-[10px] text-[var(--color-text-muted)] font-semibold block">Total Omset</span>
          <span class="font-bold font-mono text-sm sm:text-base" style="color: var(--color-primary)"><%= formatRupiah(stats.totalSales) %></span>
        </div>

        <div class="pos-card px-3.5 py-2">
          <span class="text-[10px] text-[var(--color-text-muted)] font-semibold block">Total Transaksi</span>
          <span class="font-bold font-mono text-sm sm:text-base text-[var(--color-text-main)]"><%= stats.totalCount %> Nota</span>
        </div>

        <div class="pos-card px-3.5 py-2 col-span-2 sm:col-span-1">
          <span class="text-[10px] text-[var(--color-text-muted)] font-semibold block">Rata-rata Nota</span>
          <span class="font-bold font-mono text-xs sm:text-sm text-[var(--color-text-main)]">
            <%= formatRupiah(stats.totalCount > 0 ? Math.round(stats.totalSales / stats.totalCount) : 0) %>
          </span>
        </div>
      </div>
    </div>

    <!-- Kolom Pencarian & Filter Cepat -->
    <div class="pos-card p-3.5 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3" data-aos="fade-up">
      <div class="relative w-full sm:w-80">
        <input type="text" id="search-history" oninput="filterHistory(this.value)" placeholder="Cari nomor nota, kasir, tanggal..." class="pos-input pl-8 text-xs font-mono">
        <span class="material-symbols-outlined absolute left-2.5 top-2.5 text-[var(--color-text-subtle)] text-base" aria-hidden="true">search</span>
      </div>

      <div class="text-xs text-[var(--color-text-muted)] flex items-center gap-1.5 self-end sm:self-center">
        <span>Total Tercatat:</span>
        <span id="history-count-badge" class="font-bold font-mono text-[var(--color-text-main)]"><%= transactions.length %></span>
        <span>Nota</span>
      </div>
    </div>

    <!-- Tabel Riwayat Penjualan -->
    <div class="pos-table-wrapper" data-aos="fade-up" data-aos-delay="60">
      <table class="pos-table">
        <thead>
          <tr>
            <th class="py-3 px-4">Waktu Transaksi</th>
            <th class="py-3 px-4">Nomor Nota</th>
            <th class="py-3 px-4">Petugas Kasir</th>
            <th class="py-3 px-4">Metode Bayar</th>
            <th class="py-3 px-4 text-center">Variasi Barang</th>
            <th class="py-3 px-4 text-right">Total Belanja</th>
            <th class="py-3 px-4 text-center w-28">Aksi</th>
          </tr>
        </thead>
        <tbody id="history-table-body" class="divide-y divide-[var(--color-border-subtle)]">
          <% if (transactions.length === 0) { %>
            <tr>
              <td colspan="7" class="py-12 text-center text-[var(--color-text-subtle)]">
                <span class="material-symbols-outlined text-4xl block mb-2 opacity-50" aria-hidden="true">receipt</span>
                <p class="font-semibold text-xs">Belum ada transaksi penjualan yang tercatat.</p>
                <p class="text-[11px] opacity-75 mt-0.5">Lakukan transaksi di menu Kasir untuk menghasilkan riwayat.</p>
              </td>
            </tr>
          <% } else { %>
            <% transactions.forEach(function(trx) { %>
              <tr class="history-row transition" data-search="<%= (trx.invoiceNumber + ' ' + trx.cashier + ' ' + trx.formattedDate + ' ' + trx.paymentMethod).toLowerCase() %>">
                <td class="py-3 px-4 font-mono text-[var(--color-text-muted)] text-xs"><%= trx.formattedDate %></td>
                <td class="py-3 px-4 font-bold font-mono text-xs text-[var(--color-text-main)]"><%= trx.invoiceNumber %></td>
                <td class="py-3 px-4 text-[var(--color-text-main)]"><%= trx.cashier %></td>
                <td class="py-3 px-4">
                  <span class="pos-badge pos-badge-neutral font-medium">
                    <%= trx.paymentMethod %>
                  </span>
                </td>
                <td class="py-3 px-4 text-center text-[var(--color-text-muted)] font-mono text-xs">
                  <%= trx.items ? trx.items.length : 0 %> macam
                </td>
                <td class="py-3 px-4 text-right font-mono font-bold text-xs sm:text-sm text-[var(--color-text-main)]">
                  <%= formatRupiah(trx.grandTotal) %>
                </td>
                <td class="py-3 px-4 text-center">
                  <div class="inline-flex items-center gap-1">
                    <!-- Cetak Ulang -->
                    <a href="/history/print/<%= trx.id %>" target="_blank" class="p-1 rounded text-[var(--color-text-muted)] hover:text-[var(--color-primary)] hover:bg-[var(--color-bg-subtle)] transition" title="Cetak Ulang Thermal">
                      <span class="material-symbols-outlined text-base" aria-hidden="true">print</span>
                    </a>
                    <!-- Detail Modal -->
                    <button type="button" onclick="showTransactionDetail('<%= trx.id %>')" class="p-1 rounded text-[var(--color-text-muted)] hover:text-[var(--color-primary)] hover:bg-[var(--color-bg-subtle)] transition" title="Lihat Rincian Nota">
                      <span class="material-symbols-outlined text-base" aria-hidden="true">visibility</span>
                    </button>
                    <!-- Hapus -->
                    <button type="button" onclick="deleteTransaction('<%= trx.id %>', '<%= trx.invoiceNumber %>')" class="p-1 rounded text-[var(--color-text-subtle)] hover:text-[var(--color-destructive)] hover:bg-[var(--color-destructive-subtle)] transition" title="Hapus Transaksi & Kembalikan Stok">
                      <span class="material-symbols-outlined text-base" aria-hidden="true">delete</span>
                    </button>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>

  </main>

  <!-- MODAL DETAIL TRANSAKSI -->
  <div id="detail-modal" class="pos-modal-backdrop hidden items-center justify-center p-4">
    <div class="pos-modal-card p-5 sm:p-6 relative max-h-[90vh] overflow-y-auto">
      
      <div class="flex justify-between items-center mb-3 pb-2.5 border-b border-[var(--color-border-subtle)]">
        <h3 class="font-bold text-sm sm:text-base text-[var(--color-text-main)] flex items-center gap-2">
          <span class="material-symbols-outlined text-lg text-[var(--color-primary)]" aria-hidden="true">receipt</span>
          <span>Rincian Nota Penjualan</span>
        </h3>
        <button type="button" onclick="closeDetailModal()" class="p-1 rounded text-[var(--color-text-subtle)] hover:text-[var(--color-text-main)]">
          <span class="material-symbols-outlined" aria-hidden="true">close</span>
        </button>
      </div>

      <div id="detail-content" class="space-y-3.5 text-xs">
        <div class="text-center py-6 text-[var(--color-text-subtle)]">Memuat rincian nota...</div>
      </div>

      <div class="mt-4 pt-3 border-t border-[var(--color-border-subtle)] flex justify-between items-center" id="detail-actions">
        <button type="button" onclick="closeDetailModal()" class="pos-btn pos-btn-secondary text-xs">Tutup (Esc)</button>
      </div>
    </div>
  </div>

  <!-- Footer -->
  <%- include('../partials/footer') %>

  <!-- Toast -->
  <%- include('../partials/toast') %>

  <script>
    function filterHistory(query) {
      const q = (query || '').toLowerCase().trim();
      const rows = document.querySelectorAll('.history-row');
      let count = 0;
      rows.forEach(r => {
        const text = r.getAttribute('data-search') || '';
        if (!q || text.includes(q)) {
          r.style.display = '';
          count++;
        } else {
          r.style.display = 'none';
        }
      });
      const badge = document.getElementById('history-count-badge');
      if (badge) badge.innerText = count;
    }

    async function showTransactionDetail(id) {
      const modal = document.getElementById('detail-modal');
      const content = document.getElementById('detail-content');
      modal.classList.remove('hidden');
      modal.classList.add('flex', 'active');

      try {
        const res = await fetch(`/api/transactions/${id}`);
        const json = await res.json();
        if (!json.success || !json.data) throw new Error(json.message);

        const trx = json.data;
        const formatRp = (n) => new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(n || 0);

        content.innerHTML = `
          <div class="p-3.5 rounded-xl bg-[var(--color-bg-subtle)] border border-[var(--color-border)] font-mono space-y-1.5 text-xs">
            <div class="flex justify-between">
              <span class="text-[var(--color-text-muted)] font-sans">Nomor Nota:</span>
              <span class="font-bold text-[var(--color-text-main)]">${trx.invoiceNumber}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-[var(--color-text-muted)] font-sans">Waktu:</span>
              <span class="text-[var(--color-text-main)]">${trx.formattedDate}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-[var(--color-text-muted)] font-sans">Kasir:</span>
              <span class="text-[var(--color-text-main)]">${trx.cashier}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-[var(--color-text-muted)] font-sans">Pembayaran:</span>
              <span class="font-bold text-[var(--color-text-main)]">${trx.paymentMethod}</span>
            </div>
          </div>

          <div class="border border-[var(--color-border)] rounded-xl overflow-hidden bg-[var(--color-bg-card)]">
            <table class="w-full text-left text-xs">
              <thead class="bg-[var(--color-bg-subtle)] text-[var(--color-text-muted)] text-[10px] font-bold uppercase border-b border-[var(--color-border)]">
                <tr>
                  <th class="py-2.5 px-3">Nama Barang</th>
                  <th class="py-2.5 px-2 text-center">Jumlah</th>
                  <th class="py-2.5 px-3 text-right">Subtotal</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[var(--color-border-subtle)]">
                ${trx.items.map(item => `
                  <tr>
                    <td class="py-2 px-3 font-medium text-[var(--color-text-main)]">${item.name}</td>
                    <td class="py-2 px-2 text-center font-mono text-[var(--color-text-muted)]">${item.qty}</td>
                    <td class="py-2 px-3 text-right font-mono font-bold text-[var(--color-text-main)]">${formatRp(item.price * item.qty)}</td>
                  </tr>
                `).join('')}
              </tbody>
            </table>
          </div>

          <div class="space-y-1.5 p-3.5 rounded-xl bg-[var(--color-bg-subtle)] border border-[var(--color-border)] font-mono text-xs">
            <div class="flex justify-between text-[var(--color-text-muted)]">
              <span class="font-sans">Subtotal:</span>
              <span>${formatRp(trx.subtotal)}</span>
            </div>
            ${trx.discount > 0 ? `
              <div class="flex justify-between text-[var(--color-text-muted)]">
                <span class="font-sans">Diskon:</span>
                <span>-${formatRp(trx.discount)}</span>
              </div>
            ` : ''}
            ${trx.taxAmount > 0 ? `
              <div class="flex justify-between text-[var(--color-text-muted)]">
                <span class="font-sans">PPN (${trx.taxPercent}%):</span>
                <span>${formatRp(trx.taxAmount)}</span>
              </div>
            ` : ''}
            <div class="flex justify-between font-bold text-sm pt-1.5 border-t border-[var(--color-border)] text-[var(--color-text-main)]">
              <span class="font-sans">Total Belanja:</span>
              <span style="color: var(--color-primary)">${formatRp(trx.grandTotal)}</span>
            </div>
            <div class="flex justify-between text-[var(--color-text-muted)] pt-0.5">
              <span class="font-sans">Uang Diterima:</span>
              <span>${formatRp(trx.cashReceived)}</span>
            </div>
            <div class="flex justify-between font-bold" style="color: var(--color-success)">
              <span class="font-sans">Kembalian:</span>
              <span>${formatRp(trx.change)}</span>
            </div>
          </div>
        `;

        document.getElementById('detail-actions').innerHTML = `
          <button type="button" onclick="closeDetailModal()" class="pos-btn pos-btn-secondary text-xs">Tutup</button>
          <a href="/history/print/${trx.id}" target="_blank" class="pos-btn pos-btn-primary text-xs flex items-center gap-1.5">
            <span class="material-symbols-outlined text-sm" aria-hidden="true">print</span>
            <span>Cetak Ulang Thermal</span>
          </a>
        `;
      } catch (err) {
        content.innerHTML = `<div class="text-center text-[var(--color-destructive)] py-4">Gagal memuat rincian: ${err.message}</div>`;
      }
    }

    function closeDetailModal() {
      const modal = document.getElementById('detail-modal');
      modal.classList.add('hidden');
      modal.classList.remove('flex', 'active');
    }

    async function deleteTransaction(id, invoiceNo) {
      if (!confirm(`Hapus catatan transaksi ${invoiceNo}?\n(Stok produk pada nota ini akan otomatis dikembalikan ke katalog)`)) return;

      try {
        const res = await fetch(`/api/transactions/${id}`, { method: 'DELETE' });
        const json = await res.json();
        if (!json.success) throw new Error(json.message);
        if (typeof showToast === 'function') {
          showToast('Transaksi dihapus & stok dikembalikan', 'info');
        }
        setTimeout(() => window.location.reload(), 350);
      } catch (err) {
        alert('Gagal menghapus: ' + err.message);
      }
    }

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeDetailModal();
    });
  </script>
</body>
</html>
