<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen flex flex-col">

  <!-- Header -->
  <%- include('../partials/navbar') %>

  <!-- Navigasi -->
  <%- include('../partials/navigation') %>

  <!-- Konten Utama -->
  <main class="flex-grow max-w-7xl w-full mx-auto px-4 py-5 sm:px-6 lg:px-8 flex flex-col gap-5">

    <!-- Header Judul & Tombol Tambah -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3" data-aos="fade-down">
      <div>
        <h2 class="text-base sm:text-lg font-bold flex items-center gap-2 text-[var(--color-text-main)]">
          <span class="material-symbols-outlined text-lg text-[var(--color-primary)]" aria-hidden="true">inventory_2</span>
          <span>Katalog Produk & Harga</span>
        </h2>
        <p class="text-xs text-[var(--color-text-muted)] mt-0.5">
          Kelola master data barang, harga modal, harga jual, dan stok toko Anda.
        </p>
      </div>

      <div class="flex items-center gap-2 flex-wrap">
        <a href="/products/export/csv" class="pos-btn pos-btn-secondary text-xs sm:text-sm" title="Unduh katalog produk dalam format CSV / Excel">
          <span class="material-symbols-outlined text-base" aria-hidden="true">file_download</span>
          <span>Ekspor CSV</span>
        </a>

        <button type="button" onclick="ProductManager.openRestockModal()" class="pos-btn pos-btn-secondary text-xs sm:text-sm font-semibold border-emerald-300 text-emerald-700 bg-emerald-50 hover:bg-emerald-100" title="Tambah stok barang masuk dari distributor">
          <span class="material-symbols-outlined text-base" aria-hidden="true">move_to_inbox</span>
          <span>Barang Masuk / Restock</span>
        </button>

        <button type="button" onclick="ProductManager.openAddModal()" class="pos-btn pos-btn-primary text-xs sm:text-sm">
          <span class="material-symbols-outlined text-base" aria-hidden="true">add</span>
          <span>Tambah Barang Baru</span>
        </button>
      </div>
    </div>

    <!-- Kolom Pencarian & Filter Kategori -->
    <div class="pos-card p-3.5 flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3" data-aos="fade-up">
      <!-- Search Input -->
      <div class="relative w-full sm:w-80">
        <input type="text" id="search-product-input" oninput="ProductManager.filterTable(this.value)" placeholder="Cari nama barang atau barcode..." class="pos-input pl-8 text-xs">
        <span class="material-symbols-outlined absolute left-2.5 top-2.5 text-[var(--color-text-subtle)] text-base" aria-hidden="true">search</span>
      </div>

      <!-- Category Filter Chips -->
      <div class="flex items-center gap-1.5 overflow-x-auto pb-1 md:pb-0">
        <button type="button" onclick="ProductManager.filterCategory('ALL')" class="category-chip px-2.5 py-1 rounded-lg text-xs font-semibold transition whitespace-nowrap bg-[var(--color-primary)] text-white" data-category="ALL">
          Semua (<%= products.length %>)
        </button>
        <% (categories || []).forEach(function(cat) { %>
          <button type="button" onclick="ProductManager.filterCategory('<%= cat %>')" class="category-chip px-2.5 py-1 rounded-lg text-xs font-semibold transition whitespace-nowrap bg-[var(--color-bg-subtle)] text-[var(--color-text-muted)] hover:text-[var(--color-text-main)] border border-[var(--color-border)]" data-category="<%= cat %>">
            <%= cat %>
          </button>
        <% }); %>
      </div>

      <div class="text-xs text-[var(--color-text-muted)] shrink-0 self-end md:self-center">
        Tampil: <span id="visible-product-count" class="font-bold text-[var(--color-text-main)]"><%= products.length %></span> Barang
      </div>
    </div>

    <!-- Tabel Daftar Barang -->
    <div class="pos-table-wrapper" data-aos="fade-up" data-aos-delay="60">
      <table class="pos-table">
        <thead>
          <tr>
            <th class="py-3 px-4">Barcode / Kode</th>
            <th class="py-3 px-4">Nama Produk</th>
            <th class="py-3 px-4">Kategori</th>
            <th class="py-3 px-4 text-right">Harga Modal</th>
            <th class="py-3 px-4 text-right">Harga Jual</th>
            <th class="py-3 px-4 text-center">Status Stok</th>
            <th class="py-3 px-4 text-center w-24">Aksi</th>
          </tr>
        </thead>
        <tbody id="products-table-body" class="divide-y divide-[var(--color-border-subtle)]">
          <% if (products.length === 0) { %>
            <tr>
              <td colspan="7" class="py-12 text-center text-[var(--color-text-subtle)]">
                <span class="material-symbols-outlined text-4xl block mb-2 opacity-50" aria-hidden="true">inventory</span>
                <p class="font-semibold text-xs">Belum ada barang terdaftar di katalog.</p>
                <p class="text-[11px] opacity-75 mt-0.5">Klik tombol "Tambah Barang Baru" untuk mulai mencatat stok.</p>
              </td>
            </tr>
          <% } else { %>
            <% products.forEach(function(item) { %>
              <% 
                const stock = parseInt(item.stock, 10) || 0;
                let stockBadgeClass = 'pos-badge pos-badge-success';
                let stockText = `${stock} ${item.unit || 'Pcs'}`;
                if (stock <= 0) {
                  stockBadgeClass = 'pos-badge pos-badge-danger';
                  stockText = `Habis (0 ${item.unit || 'Pcs'})`;
                } else if (stock <= 5) {
                  stockBadgeClass = 'pos-badge pos-badge-warning';
                  stockText = `Menipis: ${stock} ${item.unit || 'Pcs'}`;
                }
              %>
              <tr class="product-table-row transition" data-search="<%= (item.name + ' ' + (item.barcode || '') + ' ' + (item.category || '')).toLowerCase() %>" data-row-category="<%= item.category || 'Umum' %>">
                <td class="py-3 px-4 font-mono text-[var(--color-text-muted)] text-xs"><%= item.barcode || '-' %></td>
                <td class="py-3 px-4 font-semibold text-xs sm:text-sm text-[var(--color-text-main)]"><%= item.name %></td>
                <td class="py-3 px-4">
                  <span class="pos-badge pos-badge-neutral">
                    <%= item.category || 'Umum' %>
                  </span>
                </td>
                <td class="py-3 px-4 text-right text-[var(--color-text-muted)] font-mono text-xs"><%= formatRupiah(item.costPrice) %></td>
                <td class="py-3 px-4 text-right font-bold font-mono text-xs text-[var(--color-text-main)]"><%= formatRupiah(item.sellingPrice) %></td>
                <td class="py-3 px-4 text-center">
                  <span class="<%= stockBadgeClass %>">
                    <%= stockText %>
                  </span>
                </td>
                <td class="py-3 px-4 text-center">
                  <div class="inline-flex items-center gap-1">
                    <button type="button" onclick="ProductManager.openRestockModal('<%= item.id %>', '<%= item.name %>', <%= item.stock %>, <%= item.costPrice %>, '<%= item.unit || 'Pcs' %>')" class="p-1 rounded text-emerald-600 hover:text-emerald-700 hover:bg-emerald-50 transition" title="Restock / Barang Masuk">
                      <span class="material-symbols-outlined text-base" aria-hidden="true">move_to_inbox</span>
                    </button>
                    <button type="button" onclick="ProductManager.openEditModal('<%= item.id %>', '<%= item.barcode %>', '<%= item.name %>', '<%= item.category %>', <%= item.costPrice %>, <%= item.sellingPrice %>, '<%= item.unit %>', <%= item.stock %>)" class="p-1 rounded text-[var(--color-text-muted)] hover:text-[var(--color-primary)] hover:bg-[var(--color-bg-subtle)] transition" title="Ubah Data">
                      <span class="material-symbols-outlined text-base" aria-hidden="true">edit</span>
                    </button>
                    <button type="button" onclick="ProductManager.deleteProduct('<%= item.id %>', '<%= item.name %>')" class="p-1 rounded text-[var(--color-text-subtle)] hover:text-[var(--color-destructive)] hover:bg-[var(--color-destructive-subtle)] transition" title="Hapus Produk">
                      <span class="material-symbols-outlined text-base" aria-hidden="true">delete</span>
                    </button>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>

  </main>

  <!-- MODAL TAMBAH / EDIT BARANG -->
  <div id="product-modal" class="pos-modal-backdrop hidden items-center justify-center p-4">
    <div class="pos-modal-card p-5 sm:p-6 relative">
      
      <div class="flex justify-between items-center mb-4 pb-2.5 border-b border-[var(--color-border-subtle)]">
        <h3 id="modal-title" class="font-bold text-sm sm:text-base flex items-center gap-2 text-[var(--color-text-main)]">
          <span class="material-symbols-outlined text-lg text-[var(--color-primary)]" aria-hidden="true">inventory</span>
          <span>Tambah Barang Baru</span>
        </h3>
        <button type="button" onclick="ProductManager.closeModal()" class="p-1 rounded text-[var(--color-text-subtle)] hover:text-[var(--color-text-main)]">
          <span class="material-symbols-outlined" aria-hidden="true">close</span>
        </button>
      </div>

      <form id="prod-form" onsubmit="ProductManager.handleFormSubmit(event)" class="space-y-3.5">
        <input type="hidden" id="prod-id" value="">

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="sm:col-span-2">
            <label class="pos-label">Nama Barang / Produk *</label>
            <input type="text" id="prod-name" required placeholder="Contoh: Beras Rojolele 5kg" class="pos-input font-medium">
          </div>

          <div>
            <label class="pos-label">Kode / Barcode (Opsional)</label>
            <input type="text" id="prod-barcode" placeholder="Scan barcode disini" class="pos-input font-mono">
          </div>

          <div>
            <label class="pos-label">Kategori</label>
            <input type="text" id="prod-category" placeholder="Sembako / Makanan / Minuman" class="pos-input">
          </div>

          <div>
            <label class="pos-label">Harga Modal / Beli (Rp)</label>
            <input type="number" id="prod-cost-price" min="0" placeholder="0" class="pos-input font-mono">
          </div>

          <div>
            <label class="pos-label">
              <span>Harga Jual (Rp) *</span>
              <span id="margin-preview-badge" class="hidden"></span>
            </label>
            <input type="number" id="prod-selling-price" min="0" required placeholder="0" class="pos-input font-mono font-bold">
          </div>

          <div>
            <label class="pos-label">Jumlah Stok Awal</label>
            <input type="number" id="prod-stock" min="0" value="10" class="pos-input font-mono">
          </div>

          <div>
            <label class="pos-label">Satuan</label>
            <input type="text" id="prod-unit" value="Pcs" placeholder="Pcs / Bungkus / Kg" class="pos-input">
          </div>
        </div>

        <div class="pt-3 border-t border-[var(--color-border-subtle)] flex justify-end gap-2">
          <button type="button" onclick="ProductManager.closeModal()" class="pos-btn pos-btn-secondary text-xs">
            Batal (Esc)
          </button>
          <button type="submit" class="pos-btn pos-btn-primary text-xs">
            <span>Simpan Data Barang</span>
          </button>
        </div>
      </form>

    </div>
  </div>

  <!-- MODAL RESTOCK / BARANG MASUK -->
  <div id="restock-modal" class="pos-modal-backdrop hidden items-center justify-center p-4">
    <div class="pos-modal-card p-5 sm:p-6 relative max-w-md w-full">
      <div class="flex justify-between items-center mb-4 pb-2.5 border-b border-[var(--color-border-subtle)]">
        <h3 class="font-bold text-sm sm:text-base flex items-center gap-2 text-[var(--color-text-main)]">
          <span class="material-symbols-outlined text-lg text-emerald-600" aria-hidden="true">move_to_inbox</span>
          <span>Restock / Barang Masuk</span>
        </h3>
        <button type="button" onclick="ProductManager.closeRestockModal()" class="p-1 rounded text-[var(--color-text-subtle)] hover:text-[var(--color-text-main)]">
          <span class="material-symbols-outlined" aria-hidden="true">close</span>
        </button>
      </div>

      <form id="restock-form" onsubmit="ProductManager.handleRestockSubmit(event)" class="space-y-3.5">
        <div>
          <label class="pos-label">Pilih Produk *</label>
          <select id="restock-product-select" onchange="ProductManager.onRestockProductChange(this.value)" required class="pos-select font-medium text-xs">
            <option value="">-- Pilih Barang --</option>
            <% products.forEach(function(p) { %>
              <option value="<%= p.id %>" data-stock="<%= p.stock %>" data-cost="<%= p.costPrice %>" data-unit="<%= p.unit || 'Pcs' %>">
                <%= p.name %> (Stok: <%= p.stock %> <%= p.unit || 'Pcs' %>)
              </option>
            <% }); %>
          </select>
        </div>

        <div class="p-3 rounded-xl bg-[var(--color-bg-subtle)] border border-[var(--color-border)] text-xs space-y-1">
          <div class="flex justify-between">
            <span class="text-[var(--color-text-muted)]">Stok Saat Ini:</span>
            <span id="restock-current-stock" class="font-bold font-mono text-[var(--color-text-main)]">0 Pcs</span>
          </div>
          <div class="flex justify-between">
            <span class="text-[var(--color-text-muted)]">Harga Modal Saat Ini:</span>
            <span id="restock-current-cost" class="font-mono text-[var(--color-text-main)]">Rp0</span>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="pos-label">Jumlah Barang Masuk *</label>
            <input type="number" id="restock-qty" min="1" required placeholder="Contoh: 10" oninput="ProductManager.updateRestockPreview()" class="pos-input font-bold font-mono text-center">
          </div>
          <div>
            <label class="pos-label">Harga Modal Baru (Opsional)</label>
            <input type="number" id="restock-cost-price" min="0" placeholder="Biarkan jika sama" oninput="ProductManager.updateRestockPreview()" class="pos-input font-mono">
          </div>
        </div>

        <!-- Preview Hasil Restock -->
        <div id="restock-preview-box" class="p-3 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-xs space-y-1 text-emerald-900 dark:text-emerald-200">
          <div class="flex justify-between font-bold">
            <span>Estimasi Stok Baru:</span>
            <span id="restock-new-stock-preview" class="font-mono text-sm">0 Pcs</span>
          </div>
          <div class="flex justify-between text-[11px] opacity-80">
            <span>Estimasi Biaya Masuk:</span>
            <span id="restock-cost-subtotal" class="font-mono">Rp0</span>
          </div>
        </div>

        <div class="pt-3 border-t border-[var(--color-border-subtle)] flex justify-end gap-2">
          <button type="button" onclick="ProductManager.closeRestockModal()" class="pos-btn pos-btn-secondary text-xs">
            Batal (Esc)
          </button>
          <button type="submit" id="btn-submit-restock" class="pos-btn pos-btn-success text-xs">
            <span class="material-symbols-outlined text-sm" aria-hidden="true">check</span>
            <span>Konfirmasi Barang Masuk</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Footer -->
  <%- include('../partials/footer') %>

  <!-- Toast -->
  <%- include('../partials/toast') %>

  <!-- Data Awal untuk JS -->
  <script>
    window.PRODUCTS_DATA = <%- JSON.stringify(products) %>;
  </script>

  <!-- Scripts -->
  <script src="/js/product-manager.js"></script>
</body>
</html>
